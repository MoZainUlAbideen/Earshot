# Copy this file to .env and fill in real values. Never commit .env.

# Podcast Index (https://api.podcastindex.org) — auth needs both key and secret
PODCAST_INDEX_API_KEY=your-podcast-index-key
PODCAST_INDEX_API_SECRET=your-podcast-index-secret

# Groq (Whisper ASR + LLM inference)
GROQ_API_KEY=your-groq-key

# Local Postgres (docker-compose.yml). Keep DATABASE_URL in sync with the three above.
POSTGRES_USER=earshot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=earshot
DATABASE_URL=postgresql://earshot:change-me@localhost:5432/earshot
