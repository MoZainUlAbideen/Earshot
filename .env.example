# Copy this file to .env and fill in real values. Never commit .env.

# Podcast Index (https://api.podcastindex.org) — auth needs both key and secret
PODCAST_INDEX_API_KEY=your-podcast-index-key
PODCAST_INDEX_API_SECRET=your-podcast-index-secret

# Groq (Whisper ASR + LLM inference)
GROQ_API_KEY=your-groq-key
